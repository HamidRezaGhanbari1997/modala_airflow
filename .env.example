# =========================================================
# Project
# =========================================================
COMPOSE_PROJECT_NAME=ats_airflow

# =========================================================
# Airflow Core
# =========================================================
AIRFLOW_IMAGE_NAME=custom-airflow:2.9.3
AIRFLOW_UID=50000
AIRFLOW_GID=0

AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true

# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME_GENERATE_SECRET_KEY

AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=3020
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:3020

# Lets the stable REST API (/api/v1/...) accept HTTP Basic Auth in addition
# to the normal browser session cookie, so the wiki's admin panel can call
# it directly (e.g. POST/DELETE /api/v1/users) to keep Airflow accounts in
# sync with users created/removed there. Session-based login for the
# Airflow UI itself is unaffected.
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.session,airflow.api.auth.backend.basic_auth

AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true

# =========================================================
# Airflow Database - PostgreSQL
# =========================================================
# postgres16 = کانتینر Postgres مشترک (پروژه‌ی postgres/ در ریشه‌ی ریپو) که
# Airflow، Grafana و Wiki هرکدام دیتابیس جدای خودشان را رویش دارند. این
# سرویس روی سرور دیگری (datainfra, 172.16.1.141) اجرا می‌شود - نه روی همین
# هاست (datalake) - پس دیگر از طریق شبکه‌ی داخلی داکر (postgres_custom_net)
# در دسترس نیست و باید مستقیم از طریق IP و پورت منتشرشده‌ی هاست (5434) وصل
# شود. فایروال datainfra باید پورت 5434 را برای IP سرور datalake باز کند.
POSTGRES_HOST=172.16.1.141
POSTGRES_PORT=5434
POSTGRES_DB=ats_airflow
POSTGRES_USER=admin
POSTGRES_PASSWORD=i0ebDo>hAKg;E~gl

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://admin:i0ebDo%3EhAKg%3BE~gl@172.16.1.141:5434/ats_airflow

# برای نسخه‌های قدیمی‌تر Airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://admin:i0ebDo%3EhAKg%3BE~gl@172.16.1.141:5434/ats_airflow

# =========================================================
# Airflow Admin User
# =========================================================
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=Aa123456
AIRFLOW_ADMIN_FIRSTNAME=Hamid
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=h.ghanbari@modalalco.com

# =========================================================
# Timezone
# =========================================================
TZ=Asia/Tehran

# =========================================================
# Optional Python settings
# =========================================================
PYTHONUNBUFFERED=1
PIP_NO_CACHE_DIR=1

# =========================================================
# Mahidasht API
# =========================================================
# host.docker.internal چون API روی خود ماشین هاست اجرا میشه، نه داخل کانتینر
# این یکی بک‌اند ats-backend (Django, پورت 8080) هست - فقط برای گرفتن توکن از
# /auth/login استفاده میشه، نه برای fetch/discovery.
MAHIDASHT_API_BASE_URL=http://host.docker.internal:8080/api/v1
# توکن دیگه اینجا استاتیک نگه‌داری نمیشه (هر 24 ساعت منقضی میشه)؛ DAG با همین یوزر/پسورد
# خودش از /auth/login توکن تازه میگیره و توی dags/mahidasht/.cache/token.json کش میکنه
MAHIDASHT_API_USERNAME=airflow_mahidasht
MAHIDASHT_API_PASSWORD=_IffSfV_yE7kA47QWgjORUZgkS2uvJj4
MAHIDASHT_REQUEST_TIMEOUT_SECONDS=60

# سرویس واقعی mahidasht_bridge (FastAPI، بدون auth، مسیرهای root-level مثل
# /fetch/agent/{id} و /providers/availability) - discovery و fetch واقعی از
# اینجا میره، نه از MAHIDASHT_API_BASE_URL بالا.
MAHIDASHT_BRIDGE_BASE_URL=http://host.docker.internal:8000

# چند روز قبل از امروز، آخرین روزیه که باید دیتاش خونده بشه (واترمارک تا این حد جلو میره)
MAHIDASHT_WATERMARK_END_OFFSET_DAYS=2

# اگه برای یک provider/service_id هنوز واترمارکی ثبت نشده، از این تاریخ (شمسی، فرمت YYYY/MM/DD) شروع میکنه
# خالی بمونه یعنی فقط همون آخرین روز مجاز (امروز منهای MAHIDASHT_WATERMARK_END_OFFSET_DAYS) رو میگیره
MAHIDASHT_INITIAL_START_DATE=1405/01/01

# واترمارک همیشه از "آخرین روز موفق + 1" ادامه میده (نه آخرین روزی که فقط تلاش
# شده)، یعنی روزهای failed دوباره retry میشن. اگه یک provider مدت زیادی قطع
# باشه (مثلاً سرور Vision چند ماه down باشه)، این عدد جلوی این رو میگیره که هر
# اجرا کل اون بازه‌ی طولانی failed رو یکی‌یکی دوباره تلاش کنه: فقط N روز اخیر
# (نسبت به MAHIDASHT_WATERMARK_END_OFFSET_DAYS) retry میشه، روزهای failed
# قدیمی‌تر از این پنجره به همون حالت failed توی لاگ می‌مونن و دیگه retry نمیشن
# تا داده‌ی جدید همیشه قابل دسترسی بمونه.
MAHIDASHT_FAILED_RETRY_WINDOW_DAYS=7

# =========================================================
# Destination SQL Server (ats_staging)
# =========================================================
# host.docker.internal چون SQL Server روی خود ماشین هاست اجرا میشه، نه داخل کانتینر
MSSQL_HOST=host.docker.internal
MSSQL_PORT=1433
MSSQL_DB=ats_staging
MSSQL_USER=sa
MSSQL_PASSWORD=123456
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
